# Copy to /srv/evoluta/.env.staging on the VPS. Never commit the real file.
POSTGRES_DB=postgres
POSTGRES_USER=evoluta_staging_db
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
HOST=db
USER=evoluta_staging_db
PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
ODOO_DB=evoluta_staging
ODOO_ADMIN_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET
PUBLIC_URL=https://staging.example.com
ODOO_HTTP_PORT=8070
ODOO_LONGPOLLING_PORT=8073
FRONTEND_ROOT=/srv/evoluta-staging/frontend/dist
BACKUP_DIR=/srv/backups/evoluta/staging
BOOTSTRAP_ADMIN_LOGIN=CHANGE_ME
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
BOOTSTRAP_ADMIN_NAME=CHANGE_ME
VITE_LOGIN_TESTE_USUARIO=
VITE_LOGIN_TESTE_SENHA=
