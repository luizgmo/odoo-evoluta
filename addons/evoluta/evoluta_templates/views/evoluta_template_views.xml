<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_evoluta_template_list" model="ir.ui.view">
    <field name="name">evoluta.template.list</field>
    <field name="model">evoluta.template</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_evoluta_template_form" model="ir.ui.view">
    <field name="name">evoluta.template.form</field>
    <field name="model">evoluta.template</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_gerar_projeto" string="Gerar projeto" type="object" class="oe_highlight"/>
        </header>
        <sheet>
          <group>
            <field name="name"/>
            <field name="active"/>
            <field name="descricao"/>
          </group>
          <field name="task_ids">
            <list editable="bottom">
              <field name="name"/>
              <field name="descricao"/>
              <field name="responsavel_id"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_evoluta_template" model="ir.actions.act_window">
    <field name="name">Templates</field>
    <field name="res_model">evoluta.template</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
