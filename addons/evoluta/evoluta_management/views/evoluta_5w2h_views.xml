<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_evoluta_5w2h_list" model="ir.ui.view">
    <field name="name">evoluta.5w2h.list</field>
    <field name="model">evoluta.5w2h</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="project_id"/>
        <field name="what"/>
        <field name="who_id"/>
        <field name="date_deadline"/>
        <field name="task_id"/>
      </list>
    </field>
  </record>

  <record id="view_evoluta_5w2h_form" model="ir.ui.view">
    <field name="name">evoluta.5w2h.form</field>
    <field name="model">evoluta.5w2h</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="request_validation" string="Solicitar validação" type="object" invisible="state != 'draft'"/>
          <button name="validate_tier" string="Aprovar" type="object" invisible="not can_review"/>
          <button name="restart_validation" string="Reiniciar validação" type="object" invisible="state not in ('confirmed', 'approved')"/>
          <button name="action_create_task" string="Gerar Task" type="object" class="oe_highlight"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field name="name"/>
            <field name="project_id"/>
            <field name="task_id"/>
          </group>
          <group>
            <field name="what"/>
            <field name="why"/>
            <field name="where"/>
            <field name="date_deadline"/>
            <field name="who_id"/>
            <field name="how"/>
            <field name="how_much"/>
          </group>
          <field name="review_ids"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_evoluta_5w2h" model="ir.actions.act_window">
    <field name="name">5W2H</field>
    <field name="res_model">evoluta.5w2h</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
