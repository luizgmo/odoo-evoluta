<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_stakeholder_municipal_scope" model="ir.rule">
    <field name="name">Stakeholders: município do projeto</field>
    <field name="model_id" ref="model_evoluta_stakeholder"/>
    <field name="groups" eval="[(4, ref('evoluta_core.evoluta_group_atendente'))]"/>
    <field name="domain_force">[('project_id.municipio_id', '=', user.municipio_id.id)]</field>
