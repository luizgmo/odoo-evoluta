<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_evoluta_stakeholder_list" model="ir.ui.view">
    <field name="name">evoluta.stakeholder.list</field>
    <field name="model">evoluta.stakeholder</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="project_id"/>
        <field name="organizacao"/>
        <field name="poder"/>
        <field name="interesse"/>
        <field name="posicao"/>
        <field name="influencia"/>
      </list>
    </field>
  </record>

  <record id="view_evoluta_stakeholder_form" model="ir.ui.view">
    <field name="name">evoluta.stakeholder.form</field>
    <field name="model">evoluta.stakeholder</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="project_id"/>
            <field name="organizacao"/>
            <field name="active"/>
          </group>
          <group>
            <field name="poder"/>
            <field name="interesse"/>
            <field name="posicao"/>
            <field name="influencia"/>
          </group>
          <group>
            <field name="estrategia"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_evoluta_stakeholder" model="ir.actions.act_window">
    <field name="name">Stakeholders</field>
    <field name="res_model">evoluta.stakeholder</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
