<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="evoluta_group_atendente" model="res.groups">
    <field name="name">Evoluta Atendente</field>
  </record>
  <record id="evoluta_group_secretario" model="res.groups">
    <field name="name">Evoluta Secretário</field>
    <field name="implied_ids" eval="[(4, ref('evoluta_group_atendente'))]"/>
  </record>
  <record id="evoluta_group_admin" model="res.groups">
    <field name="name">Evoluta Admin Municipal</field>
    <field name="implied_ids" eval="[(4, ref('evoluta_group_secretario'))]"/>
  </record>
</odoo>
