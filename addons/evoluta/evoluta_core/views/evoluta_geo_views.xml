<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_evoluta_municipio_list" model="ir.ui.view">
    <field name="name">evoluta.municipio.list</field>
    <field name="model">evoluta.municipio</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="codigo_ibge"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="view_evoluta_municipio_form" model="ir.ui.view">
    <field name="name">evoluta.municipio.form</field>
    <field name="model">evoluta.municipio</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="codigo_ibge"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_evoluta_municipio" model="ir.actions.act_window">
    <field name="name">Municípios</field>
    <field name="res_model">evoluta.municipio</field>
    <field name="view_mode">list,form</field>
  </record>

