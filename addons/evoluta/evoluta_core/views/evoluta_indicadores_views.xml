<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_evoluta_indicadores_list" model="ir.ui.view">
    <field name="name">project.project.evoluta.indicadores.list</field>
    <field name="model">project.project</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="evoluta_total_tasks"/>
        <field name="evoluta_done_tasks"/>
        <field name="evoluta_overdue_tasks"/>
      </list>
    </field>
  </record>

  <record id="view_evoluta_indicadores_graph" model="ir.ui.view">
    <field name="name">project.project.evoluta.indicadores.graph</field>
    <field name="model">project.project</field>
    <field name="arch" type="xml">
      <graph>
        <field name="name"/>
        <field name="evoluta_total_tasks" type="measure"/>
        <field name="evoluta_done_tasks" type="measure"/>
        <field name="evoluta_overdue_tasks" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="action_evoluta_indicadores" model="ir.actions.act_window">
    <field name="name">Indicadores</field>
    <field name="res_model">project.project</field>
    <field name="view_mode">list,graph</field>
  </record>
</odoo>
