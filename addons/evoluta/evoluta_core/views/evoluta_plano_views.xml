<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_evoluta_plano_list" model="ir.ui.view">
    <field name="name">evoluta.plano.list</field>
    <field name="model">evoluta.plano</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="max_users"/>
        <field name="max_projects"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="view_evoluta_plano_form" model="ir.ui.view">
    <field name="name">evoluta.plano.form</field>
    <field name="model">evoluta.plano</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="max_users"/>
            <field name="max_projects"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_evoluta_plano" model="ir.actions.act_window">
    <field name="name">Planos</field>
    <field name="res_model">evoluta.plano</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_evoluta_onboarding_list" model="ir.ui.view">
    <field name="name">evoluta.onboarding.list</field>
    <field name="model">evoluta.onboarding</field>
    <field name="arch" type="xml">
      <list editable="top">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="done"/>
      </list>
    </field>
  </record>
  <record id="view_evoluta_onboarding_form" model="ir.ui.view">
    <field name="name">evoluta.onboarding.form</field>
    <field name="model">evoluta.onboarding</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="done"/>
            <field name="description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_evoluta_onboarding" model="ir.actions.act_window">
    <field name="name">Onboarding</field>
    <field name="res_model">evoluta.onboarding</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
