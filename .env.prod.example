# Copy to /srv/evoluta/.env.prod on the VPS. Never commit the real file.
POSTGRES_DB=postgres
POSTGRES_USER=evoluta_prod_db
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
HOST=db
USER=evoluta_prod_db
PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
ODOO_DB=evoluta_prod
ODOO_ADMIN_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET
PUBLIC_URL=https://app.example.com
ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072
FRONTEND_ROOT=/srv/evoluta-prod/frontend/dist
BACKUP_DIR=/srv/backups/evoluta/prod
BOOTSTRAP_ADMIN_LOGIN=CHANGE_ME
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
BOOTSTRAP_ADMIN_NAME=CHANGE_ME
